# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Dodo Payments — see src/lib/dodo.server.ts for setup notes and caveats.
# DODO_PAYMENTS_PRODUCT_ID must point at a product configured for dynamic
# ("pay what you want") pricing, since bid amounts vary $2-$6 per keycap.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_SECRET=
